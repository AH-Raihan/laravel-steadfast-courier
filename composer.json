{
    "name": "ahraihan/laravel-steadfast-courier",
    "description": "Steadfast Courier API (18 endpoints) and Webhook integration for Laravel",
    "keywords": [
        "laravel",
        "steadfast",
        "steadfast-courier",
        "courier",
        "bangladesh",
        "shipping",
        "webhook",
        "logistics",
        "packzy"
    ],
    "homepage": "https://github.com/dev-ahraihan/laravel-steadfast-courier",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "AH-Raihan",
            "email": "dev.ahraihan@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0|^5.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "AhRaihan\\SteadfastCourier\\": "src/",
            "SteadFast\\SteadFastCourierLaravelPackage\\": "src/Compatibility/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AhRaihan\\SteadfastCourier\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AhRaihan\\SteadfastCourier\\SteadfastServiceProvider"
            ],
            "aliases": {
                "Steadfast": "AhRaihan\\SteadfastCourier\\Facades\\Steadfast",
                "SteadfastCourier": "AhRaihan\\SteadfastCourier\\Facades\\SteadfastCourier"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

